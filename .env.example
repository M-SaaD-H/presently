# Server

# Redis connection string (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Recording

# Number of concurrent recordings (must match Xvfb display pool size)
MAX_CONCURRENT_WORKERS=3

# First Xvfb virtual display number; subsequent displays are +1, +2, etc.
XVFB_DISPLAY_START=99

# Default scroll duration in seconds (each recording job can override this)
TARGET_DURATION_SECONDS=30

# Absolute path to the Google Chrome / Chromium executable
# Default: /usr/bin/google-chrome-stable
CHROME_EXECUTABLE=/usr/bin/google-chrome-stable

# Storage

# Where to store completed recordings: 'local' or 'cloudinary'
STORAGE_TYPE=local

# Directory for local output files (only used when STORAGE_TYPE=local)
OUTPUT_DIR=./output

# Cloudflare (only required when STORAGE_TYPE=cloudinary)

CLOUDINARY_URL=CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
