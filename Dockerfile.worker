FROM oven/bun:1 AS builder

WORKDIR /app

# Install dependencies
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy source files needed by the worker
COPY worker ./worker
COPY lib ./lib
COPY models ./models
COPY utils ./utils
COPY proxy.ts ./
COPY tsconfig.json ./


# Runner Stage
FROM oven/bun:1-slim AS runner

WORKDIR /app
ENV NODE_ENV=production

# Install system dependencies required by the worker: Xvfb, FFmpeg, and Chromium
RUN apt-get update && apt-get install -y \
    xvfb \
    x11-utils \
    ffmpeg \
    chromium \
    && rm -rf /var/lib/apt/lists/*

# Instruct Playwright to use the system Chromium
ENV CHROME_EXECUTABLE=/usr/bin/chromium

# Copy dependencies and worker source from the builder stage
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/worker ./worker
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/models ./models
COPY --from=builder /app/utils ./utils
COPY --from=builder /app/proxy.ts ./
COPY --from=builder /app/tsconfig.json ./

# Create necessary directories and ensure proper permissions
RUN mkdir -p output tmp /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && chown -R bun:bun /app/output /app/tmp

# Run the worker as non-root user
USER bun

CMD ["bun", "run", "worker"]